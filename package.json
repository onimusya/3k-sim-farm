{
  "name": "fields-of-the-fractured-han",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A playable low-poly late-Han farm-life day in Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "shots": "node tools/capture.mjs --out=shots/latest --port=5277",
    "sheet": "node tools/contactsheet.mjs shots/latest",
    "baseline": "node tools/baseline.mjs --out=shots/base --port=5277",
    "smoke": "node tools/smoke.mjs --port=5277 --drive=KeyW --action=KeyE --events=interaction:attempt",
    "daytest": "node tools/daytest.mjs --port=5277",
    "profile": "node tools/profile.mjs --port=5277 --dpr=2 --frames=900 --runs=3"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "vite": "^7.0.0"
  }
}
